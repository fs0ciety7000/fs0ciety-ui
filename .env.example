# Noms des variables d'environnement du projet, avec des valeurs FACTICES.
# Les vraies valeurs : kit secrets add NOM        (projet : secrets/dev.enc.json)
#                      kit secrets add NOM -g     (clé partagée entre projets)
# Vérifier : kit secrets check

# --- Exemples (remplace par les variables réelles du projet) ---
# Cloudflare (jeton API limité à la zone et aux permissions nécessaires)
CLOUDFLARE_API_TOKEN=changeme
CLOUDFLARE_ACCOUNT_ID=changeme

# Coolify
COOLIFY_BASE_URL=https://coolify.example.com
COOLIFY_ACCESS_TOKEN=changeme

# Application
DATABASE_URL=postgres://user:password@localhost:5432/app
SESSION_SECRET=changeme
