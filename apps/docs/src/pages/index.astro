---
import "@fs0lab/css";
---
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>fs0ciety</title>
  </head>
  <body>
    <main class="fs-container fs-stack" style="padding-block: var(--fs-space-12)">
      <h1 data-fs-fx="scan bleed">fs0ciety</h1>
      <p class="fs-label">Design system · Schematic Bleed</p>
      <div class="fs-cluster">
        <label for="theme" class="fs-label">Thème</label>
        <select id="theme">
          <option value="schematic">schematic</option>
          <option value="night">night</option>
          <option value="light">light</option>
        </select>
      </div>
    </main>
    <script>
      const select = document.getElementById("theme") as HTMLSelectElement | null;
      if (select) {
        select.value =
          document.documentElement.dataset.fsTheme ??
          (matchMedia("(prefers-color-scheme: light)").matches ? "light" : "schematic");
        select.addEventListener("change", () => {
          document.documentElement.dataset.fsTheme = select.value;
        });
      }
    </script>
  </body>
</html>
