{
	"name": "@fs0lab/icons-svelte",
	"version": "0.0.0",
	"description": "fs0ciety icons as Svelte 5 components.",
	"license": "MIT",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/fsociety7000/fs0ciety-ui.git",
		"directory": "packages/icons-svelte"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist"
	],
	"sideEffects": [
		"**/*.css"
	],
	"scripts": {
		"build": "svelte-package -i src/lib -o dist",
		"typecheck": "svelte-check --tsconfig ./tsconfig.json",
		"test": "vitest run --passWithNoTests"
	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"devDependencies": {
		"@sveltejs/package": "^3.0.2",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8"
	}
}
