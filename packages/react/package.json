	],
	"sideEffects": false,
	"scripts": {
		"build": "tsdown src/index.ts --dts",
		"typecheck": "tsc --noEmit",
		"test": "vitest run --passWithNoTests"
	},
	"peerDependencies": {
		"react": "^19.0.0",
		"react-dom": "^19.0.0"
	}
