{
	"name": "@fs0lab/react",
	"version": "0.0.0",
	"private": true,
	"description": "fs0ciety components for React 19 (RSC-compatible).",
	"license": "MIT",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/fsociety7000/fs0ciety-ui.git",
		"directory": "packages/react"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
