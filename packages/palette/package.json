{
	"name": "@fs0lab/palette",
	"version": "0.0.0",
	"private": true,
	"description": "OKLCH palette generator: 50–950 scales, semantic roles, WCAG/APCA contrast, CVD simulation. Library + `fs0` CLI.",
	"license": "MIT",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/fsociety7000/fs0ciety-ui.git",
		"directory": "packages/palette"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"default": "./dist/index.mjs"
		}
	},
	"files": [
		"dist"
	],
	"sideEffects": false,
	"scripts": {
		"build": "tsdown src/index.ts --dts",
		"typecheck": "tsc --noEmit",
		"test": "vitest run --passWithNoTests"
	}
