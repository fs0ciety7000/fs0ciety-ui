{
	"name": "@fs0lab/css",
	"version": "0.1.0",
	"description": "fs0ciety CSS: reset, base, utilities and CSS-only effects, in cascade layers.",
	"license": "MIT",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/fs0ciety7000/fs0ciety-ui.git",
		"directory": "packages/css"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"exports": {
		".": {
			"types": "./dist/css.d.mts",
			"default": "./dist/fs.css"
		},
		"./*.css": {
			"types": "./dist/css.d.mts",
			"default": "./dist/*.css"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist"
	],
	"sideEffects": [
		"**/*.css"
	],
	"scripts": {
		"build": "node scripts/build.mjs",
		"test": "vitest run",
		"typecheck": "tsc --noEmit",
		"test:e2e": "playwright test",
		"test:e2e:docker": "docker run --rm --ipc=host --user \"$(id -u):$(id -g)\" -e HOME=/tmp -e CI=1 -v \"$PWD/../..:/work\" -w /work/packages/css mcr.microsoft.com/playwright:v1.64.1-noble sh -c '[ \"$1\" = -- ] && shift; exec node node_modules/@playwright/test/cli.js test \"$@\"' sh"
	},
	"dependencies": {
		"@fs0lab/tokens": "workspace:^0.1.1"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.14.0",
		"@fontsource-variable/inter-tight": "^5.3.0",
		"@fontsource-variable/martian-mono": "^5.3.0",
		"@playwright/test": "1.64.1",
		"@types/node": "^22.20.5",
		"http-server": "^14.1.1",
		"lightningcss": "^1.33.0"
	}
}
