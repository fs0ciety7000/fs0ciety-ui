{
	"name": "@fs0lab/css",
	"version": "0.0.0",
	"private": true,
	"description": "fs0ciety CSS: reset, base, utilities and CSS-only effects, in cascade layers.",
	"license": "MIT",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/fs0ciety7000/fs0ciety-ui.git",
		"directory": "packages/css"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"exports": {
		".": {
			"types": "./dist/css.d.mts",
			"default": "./dist/fs.css"
		},
		"./*.css": {
			"types": "./dist/css.d.mts",
			"default": "./dist/*.css"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist"
	],
	"sideEffects": [
		"**/*.css"
	],
	"scripts": {
		"build": "node scripts/build.mjs",
		"test": "vitest run",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@fs0lab/tokens": "workspace:^0.1.0"
	},
	"devDependencies": {
		"@types/node": "^22.20.5",
		"lightningcss": "^1.33.0"
	}
}
