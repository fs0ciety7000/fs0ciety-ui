{
	"name": "@fs0lab/tokens",
	"version": "0.0.0",
	"description": "fs0ciety design tokens (W3C DTCG) → CSS variables, JS/TS, Tailwind preset, Figma JSON.",
	"license": "MIT",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/fsociety7000/fs0ciety-ui.git",
		"directory": "packages/tokens"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs",
			"default": "./dist/index.mjs"
		},
		"./css": "./dist/css/tokens.css",
		"./tailwind.css": "./dist/tailwind.css",
		"./figma/*": "./dist/figma/*",
		"./tokens/*": "./tokens/*",
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"tokens"
	],
	"sideEffects": [
		"**/*.css"
	],
	"scripts": {
		"gen": "node scripts/build.mjs",
		"build": "pnpm gen && tsdown",
		"typecheck": "pnpm gen && tsc --noEmit",
		"test": "vitest run"
	},
	"devDependencies": {
		"@types/culori": "^4.0.1",
		"@types/node": "^22.20.5",
		"apca-w3": "^0.1.9",
		"culori": "^4.0.2",
		"style-dictionary": "^5.8.0"
	}
}
