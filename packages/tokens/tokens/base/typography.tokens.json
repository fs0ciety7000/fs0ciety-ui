{
	"font": {
		"display": {
			"$type": "fontFamily",
			"$value": ["fs0 Mono", "Martian Mono", "ui-monospace", "monospace"]
		},
		"sans": {
			"$type": "fontFamily",
			"$value": ["Inter Tight", "system-ui", "sans-serif"]
		},
		"mono": {
			"$type": "fontFamily",
			"$value": ["fs0 Mono", "Martian Mono", "ui-monospace", "monospace"]
		},
		"display-stretch": {
			"$type": "number",
			"$value": "75%",
			"$extensions": {
				"fs0.raw": true
			}
		},
		"mono-stretch": {
			"$type": "number",
			"$value": "100%",
			"$extensions": {
				"fs0.raw": true
			}
		}
	},
	"text": {
		"2xs": {
			"size": {
				"$type": "dimension",
				"$value": {
					"value": 11,
					"unit": "px"
				}
			},
			"line-height": {
				"$type": "dimension",
				"$value": {
					"value": 16,
					"unit": "px"
				}
			},
			"tracking": {
				"$type": "dimension",
				"$value": "0.04em",
				"$extensions": {
					"fs0.raw": true
				}
			},
			"weight": {
				"$type": "fontWeight",
				"$value": 500
			}
		},
		"xs": {
			"size": {
				"$type": "dimension",
				"$value": {
					"value": 12,
					"unit": "px"
				}
			},
			"line-height": {
				"$type": "dimension",
				"$value": {
					"value": 18,
					"unit": "px"
				}
			},
			"tracking": {
				"$type": "dimension",
				"$value": "0.02em",
				"$extensions": {
					"fs0.raw": true
				}
			},
			"weight": {
				"$type": "fontWeight",
				"$value": 500
			}
		},
		"sm": {
			"size": {
				"$type": "dimension",
				"$value": {
					"value": 14,
					"unit": "px"
				}
			},
			"line-height": {
				"$type": "dimension",
				"$value": {
					"value": 21,
					"unit": "px"
				}
			},
			"tracking": {
				"$type": "dimension",
				"$value": "0em",
				"$extensions": {
					"fs0.raw": true
				}
			},
			"weight": {
				"$type": "fontWeight",
				"$value": 400
			}
		},
		"md": {
			"size": {
				"$type": "dimension",
				"$value": {
					"value": 16,
					"unit": "px"
				}
			},
			"line-height": {
				"$type": "dimension",
				"$value": {
					"value": 26,
					"unit": "px"
				}
			},
			"tracking": {
				"$type": "dimension",
				"$value": "0em",
				"$extensions": {
					"fs0.raw": true
				}
			},
			"weight": {
				"$type": "fontWeight",
				"$value": 400
			}
		},
		"lg": {
			"size": {
				"$type": "dimension",
				"$value": {
					"value": 18,
					"unit": "px"
				}
			},
			"line-height": {
				"$type": "dimension",
				"$value": {
					"value": 28,
					"unit": "px"
				}
			},
			"tracking": {
				"$type": "dimension",
				"$value": "-0.005em",
				"$extensions": {
					"fs0.raw": true
				}
			},
			"weight": {
				"$type": "fontWeight",
				"$value": 400
			}
		},
		"xl": {
			"size": {
				"$type": "dimension",
				"$value": {
					"value": 28,
					"unit": "px"
				}
			},
			"line-height": {
				"$type": "dimension",
				"$value": {
					"value": 32,
					"unit": "px"
				}
			},
			"tracking": {
				"$type": "dimension",
				"$value": "-0.02em",
				"$extensions": {
					"fs0.raw": true
				}
			},
			"weight": {
				"$type": "fontWeight",
				"$value": 700
			}
		},
		"2xl": {
			"size": {
				"$type": "dimension",
				"$value": "clamp(40px, 4vw + 1rem, 76px)",
				"$extensions": {
					"fs0.raw": true
				}
			},
			"line-height": {
				"$type": "number",
				"$value": 0.92
			},
			"tracking": {
				"$type": "dimension",
				"$value": "-0.04em",
				"$extensions": {
					"fs0.raw": true
				}
			},
			"weight": {
				"$type": "fontWeight",
				"$value": 800
			}
		},
		"display": {
			"size": {
				"$type": "dimension",
				"$value": "clamp(56px, 8vw, 108px)",
				"$extensions": {
					"fs0.raw": true
				}
			},
			"line-height": {
				"$type": "number",
				"$value": 0.9
			},
			"tracking": {
				"$type": "dimension",
				"$value": "-0.04em",
				"$extensions": {
					"fs0.raw": true
				}
			},
			"weight": {
				"$type": "fontWeight",
				"$value": 800
			}
		}
	}
}
